# Path or URL every portal's api client prefixes to requests. Keep it relative so
# requests go through the Vite proxy (dev) or the ingress (production).
VITE_API_BASE_URL=/api/v1
# Dev/preview only: where Vite forwards /api. One backend for all four portals.
VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_ENV=development
