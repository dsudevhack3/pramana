ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://app_insert_only:password@localhost:5432/prescription_provenance
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET_KEY=change-me-to-a-random-32-plus-character-secret
