MCA_GST_REGISTRY_API_KEY=changeme

PHARMACY_COUNCIL_REGISTRY_BASE_URL=https://api.example-pharmacy-council.gov.in
PHARMACY_COUNCIL_REGISTRY_API_KEY=changeme

GOOGLE_MAPS_API_KEY=changeme

CDSCO_FORMULARY_BASE_URL=https://api.example-cdsco-formulary.gov.in
